<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
    
    <!-- 主配置框架 -->
    <Frame name="ChatFilterConfigFrame" parent="UIParent" movable="true" enableMouse="true" hidden="true">
        <Size x="450" y="580"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets>
                <AbsInset left="8" right="8" top="8" bottom="8"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="32"/>
            </EdgeSize>
        </Backdrop>
        
        <Frames>
            <!-- 标题 -->
            <Frame name="$parentTitleFrame">
                <Size x="400" y="30"/>
                <Anchors>
                    <Anchor point="TOP" relativePoint="TOP">
                        <Offset x="0" y="-20"/>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentTitle" inherits="GameFontNormalLarge" text="聊天关注词设置">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            
            <!-- 启用复选框 -->
            <CheckButton name="$parentEnableCheckbox" inherits="UICheckButtonTemplate">
                <Size x="24" y="24"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT">
                        <Offset x="20" y="-60"/>
                    </Anchor>
                </Anchors>
            </CheckButton>
            
            <!-- 启用标签 -->
            <Frame name="$parentEnableLabel">
                <Size x="200" y="24"/>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentEnableCheckbox">
                        <Offset x="5" y="0"/>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentText" inherits="GameFontNormal" text="启用关注词功能,同时屏蔽对立阵营大喊">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!-- 高亮复选框 -->
            <CheckButton name="$parentHighlightCheckbox" inherits="UICheckButtonTemplate">
                <Size x="24" y="24"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT">
                        <Offset x="20" y="-85"/>
                    </Anchor>
                </Anchors>
            </CheckButton>
            
            <!-- 高亮标签 -->
            <Frame name="$parentHighlightLabel">
                <Size x="300" y="24"/>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentHighlightCheckbox">
                        <Offset x="5" y="0"/>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentText" inherits="GameFontNormal">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                            <Color r="1" g="0" b="0"/>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            
            <!-- 当前区域 -->
            <!-- <Frame name="$parentZoneFrame">
                <Size x="400" y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT">
                        <Offset x="20" y="-115"/>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentZoneLabel" inherits="GameFontNormal" text="当前区域: ">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                        </FontString>
                        <FontString name="$parentZoneText" inherits="GameFontHighlight">
                            <Anchors>
                                <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentZoneLabel">
                                    <Offset x="5" y="0"/>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame> -->
            
            <!-- 阵营语言 -->
            <Frame name="$parentFactionFrame">
                <Size x="400" y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT">
                        <Offset x="20" y="-140"/>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentFactionLabel" inherits="GameFontNormal" text="当前阵营语言: ">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                        </FontString>
                        <FontString name="$parentFactionText" inherits="GameFontHighlight">
                            <Anchors>
                                <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentFactionLabel">
                                    <Offset x="5" y="0"/>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            
            <!-- 关注说明 -->
            <Frame name="$parentInfoFrame">
                <Size x="400" y="60"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT">
                        <Offset x="20" y="-165"/>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentInfoText" inherits="GameFontNormalSmall" justifyH="LEFT">
                            <Size x="400" y="60"/>
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                            </Anchors>
                            <Color r="0.67" g="0.67" b="0.67"/>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            
            <!-- 输入框标签 -->
            <Frame name="$parentInputLabel">
                <Size x="200" y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT">
                        <Offset x="20" y="-235"/>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentText" inherits="GameFontNormal" text="添加关注词:">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            
            <!-- 输入框 -->
            <EditBox name="$parentInputBox" inherits="InputBoxTemplate" autoFocus="false" letters="50">
                <Size x="300" y="30"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT">
                        <Offset x="20" y="-255"/>
                    </Anchor>
                </Anchors>
            </EditBox>
            
            <!-- 添加按钮 -->
            <Button name="$parentAddButton" inherits="UIPanelButtonTemplate" text="添加">
                <Size x="80" y="30"/>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$parentInputBox">
                        <Offset x="10" y="0"/>
                    </Anchor>
                </Anchors>
            </Button>
            
            <!-- 滚动框架 -->
            <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT">
                        <Offset x="20" y="-295"/>
                    </Anchor>
                    <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT">
                        <Offset x="-40" y="50"/>
                    </Anchor>
                </Anchors>
                <ScrollChild>
                    <Frame name="$parentScrollChild">
                        <Size x="360" y="1"/>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
            
            <!-- 关闭按钮 -->
            <Button name="$parentCloseButton" inherits="UIPanelButtonTemplate" text="关闭">
                <Size x="80" y="30"/>
                <Anchors>
                    <Anchor point="BOTTOM" relativePoint="BOTTOM">
                        <Offset x="0" y="15"/>
                    </Anchor>
                </Anchors>
            </Button>
            
        </Frames>
        
        <Scripts>
            <OnLoad>
                -- 设置高亮标签文本
                ChatFilterConfigFrameHighlightLabelText:SetText("启用关注词绿色高亮 (否则默认颜色展示)")
            </OnLoad>
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
        </Scripts>
    </Frame>
    
</Ui>
